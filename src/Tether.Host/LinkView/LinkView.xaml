<UserControl x:Class="Tether.Host.LinkView.LinkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- rows or columns set in code: graph above the timeline when narrow, beside it when it is a wide strip -->
    <Grid x:Name="Root">
        <Grid x:Name="Graph" Margin="4" Height="80" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="40"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="NodeA" Width="72" Height="72" CornerRadius="36" BorderThickness="2" Background="#2D2D30">
                <TextBlock x:Name="LabelA" Foreground="#DDD" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Rectangle x:Name="LinkLine" Grid.Column="1" Height="3" Fill="Gray" VerticalAlignment="Center"/>
            <Canvas x:Name="DotLane" Grid.Column="1" Height="10" VerticalAlignment="Center">
                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="White" Visibility="Hidden"/>
            </Canvas>
            <Border x:Name="NodeB" Grid.Column="2" Width="72" Height="72" CornerRadius="36" BorderThickness="2" Background="#2D2D30">
                <TextBlock x:Name="LabelB" Foreground="#DDD" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
        <ListBox x:Name="Timeline" Background="Transparent" BorderThickness="0" Margin="4"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ToolTip="클릭하면 요청·응답 미리보기">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="11" TextWrapping="Wrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
